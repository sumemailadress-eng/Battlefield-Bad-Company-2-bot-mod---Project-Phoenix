# build outputs
# (1.8.3b: bin\PhoenixBC2.dll, bin\PhoenixAttach.exe and Phoenix-Classic-Launcher.exe are kept in the repo so
#  every download has the programs)
bin/*
!bin/PhoenixBC2.dll
!bin/PhoenixAttach.exe
!bin/PhoenixOffline.exe
harness/phoenix_harness
/PhoenixLauncher.exe
*.o
*.obj
# generated navigation caches (per-map, machine-specific)
navcache/*
# ...except the vehicle routes that ship with Phoenix
!navcache/*.vroutes
!navcache/README.md
*.dscan
/thumbs/
